<div class="container overflow-auto text-center" id="div_tree">
    <div class="tree" id="render_efectos">
        ...
    </div>
    <br>
    <div class="one" id="render_central">
        ...
    </div>
    <br>
    <div class="two" id="render_tree">
        ...
    </div>
