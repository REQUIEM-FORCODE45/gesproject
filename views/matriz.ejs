            export_tabla = "#div_problem_promedio"
        }

        var csv = [];
        var tabla = document.querySelector(export_tabla);
        var rows = tabla.querySelectorAll("table tr");
        var newCol = ""

        for (var i = 0; i < rows.length; i++) {
            var row = [], cols = rows[i].querySelectorAll("td, th, input");

            for (var j = 0; j < cols.length; j++) {
                if(cols[j].innerText == ''){
                    newCol = cols[j].value
                } else {
                    newCol = cols[j].innerText
                }
                console.log(newCol)

                if(newCol != undefined){
                    if(newCol == 'Dependencia'){
                        newCol = newCol + ','
                        row.push(newCol);
                    } else{
                        row.push(newCol);
                    }
                }

                
            }
            csv.push(row.join(","));
        }
        // Download CSV file
        downloadCSV(csv.join("\n"), filename);
    }

    async function print_grafica(){
        const options = {
                margin: 1,
                filename: 'grafica.pdf',
                image: { 
                    type: 'jpeg', 
                    quality: 0.98 
                },
                html2canvas: { 
                    scale: 1 
                },
                jsPDF: { 
                    unit: 'in', 
                    format: 'b4', 
                    orientation: 'landscape' 
                }
            }
            let element = document.getElementById('div_grafica')

            let worker = await html2pdf().from(element).set(options).toPdf().output('blob').then((data) => {
                // console.log(data)
                let fileURL = URL.createObjectURL(data);
                window.open(fileURL);
            })
    }

    function image_graph(){
        const imageLink = document.createElement('a')
        const canvas = document.getElementById('grafica')
        imageLink.download = 'canvaas.png'
        imageLink.href = canvas.toDataURL('image/png', 1)

        imageLink.click()
    }

    // objetivos
    async function save_obj(){
        let obj_central = document.getElementById('objetivo_general')
        let objs_especificos = document.getElementsByName('obj_especifico')
        let tree_id = document.getElementById('tree_id').value
        let save = true
        console.log(obj_central.value)

        let arr_objs_especificos = []
        objs_especificos.forEach(element => {
            if(element.value === ''){
                console.log('element invalid')
                element.classList.add('is-invalid')
                save=false;
            } 

            let obj = {
                id_problem: element.id,
                objetivo: element.value
            }
            arr_objs_especificos.push(obj)
        })

        console.log(arr_objs_especificos)

        if(save){
            console.log('send to back obj')
            let url = `/tree/objetivos/${vig_tec_id}/${tree_id}`
            await axios.post(url, {
                obj_central: obj_central.value,
                objs_especificos: arr_objs_especificos
            })
            .then(function(response) {
                console.log(response)
            })
            .catch(function(error){
                console.log(error)
            })
        } else {
            alert_danger('Complete los campos')
        }

    }

    function reload_page(){
        location.reload();
    }

    window.onload = function() {
        get_all_problems();
    }
</script>


