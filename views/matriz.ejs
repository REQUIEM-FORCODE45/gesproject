    async function render_matriz_promedio(problems_array){
        // sacar la tabla promedio
        console.log('problems_array')
        console.log(problems_array.length)
        let render_tbody_promedio = ''
        let casillas_promedio = ''
        let result_col_promedio = ''
        let result_suma = 0
        let cont = 0
        problem_data = []

        let render_thead = `
            <th class="text-center">#</th>
            <th class="text-center">Sigla</th>
        `

        for (let index = 0; index < problems_array.length; index++) {
            let result_fila = 0
            let result_col = 0
            casillas_promedio = ''
            render_tbody_promedio += `
                <tr id="fila_promedio_${problems_array[index]._id}">
                    <th class="text-center">P${index+1}</th>
                    <td title="${problems_array[index].title}:\n${problems_array[index].description}">
                        <p class="lh-2 lim-text mb-1">${problems_array[index].sigla}</p>
                    </td>
            `
            for (let j = 0; j < problems_array.length; j++) {
                let casilla_result = 0
                let casilla_title_users = ''
                let col_casilla_result = 0
                for (let k = 0; k < problems_array[index].reg_users.length; k++) {
                    let reg_users = problems_array[index].reg_users[k]    
                    let value_problem_find = reg_users.values.find(value => value.id_problem_col == problems_array[j]._id) 
                    if(value_problem_find){
                        casilla_result += parseInt(value_problem_find.value)/problems_array[index].reg_users.length
                        casilla_title_users += reg_users.user_name + ': ' + value_problem_find.value + '\n'
                    }
                }
                result_fila += casilla_result

                for (let k = 0; k < problems_array[j].reg_users.length; k++) {
                    let reg_users = problems_array[j].reg_users[k]    
                    let value_problem_find = reg_users.values.find(value => value.id_problem_col == problems_array[index]._id) 
                    if(value_problem_find){
                        col_casilla_result += parseInt(value_problem_find.value)/problems_array[j].reg_users.length
                    }
                }
                result_col += col_casilla_result
                // console.log('index= ' + j + ' - contador= ' + cont)
                if(j == cont){
                    casillas_promedio += `
                        <td>
                            <input type="number" class="form-control text-center bg-danger" value="0" min="0" max="3" disabled>
                        </td>
                        `
                } else {
                    if(casilla_result != 0){
                        casillas_promedio += `
                            <td>
                                <input type="number" class="form-control text-center" id="${problems_array[index]._id}" name="" value="${casilla_result.toFixed(2)}" min="0" max="3" disabled
                                title="Como influye P${index+1}-${problems_array[index].title}, sobre P${j+1}-${problems_array[j].title}\n${casilla_title_users}">
                            </td>
                            `
                    } else {
                        casillas_promedio += `
                            <td>
                                <input type="number" class="form-control text-center" id="${problems_array[j]._id}" name="" value="0" min="0" max="3" disabled
                                title="Como influye P${j+1}-${problems_array[j].title}, sobre P${index+1}-${problems_array[index].title}">
                            </td>
                            `
                    }
                }
            }
            cont++
            render_thead += `
                <th class="text-center" style="min-width: 100px;" title="${problems_array[index].title}">
                    P${index+1}-${problems_array[index].sigla}
                </th>
            `
            let data_result_problem = {
                'title': problems_array[index].title,
                'description': problems_array[index].description,
                'sigla': problems_array[index].sigla,
                'index': 'P' + (index+1),
                'result_fila': result_fila,
                'result_col': result_col
            }    
            problem_data.push(data_result_problem)

            result_suma += result_col

            render_tbody_promedio += `
                    ${casillas_promedio}
                    <td class="text-center">${result_fila.toFixed(2)}</td>
                </tr>
            `
            result_col_promedio += `
                <td class="text-center">${result_col.toFixed(2)}</td>
            `
        }
        render_thead += `
            <th>    
                Influencia
            </th>
            
        `

        render_tbody_promedio += `
            <th class="text-center" colspan="2">Dependencia</th>
            ${result_col_promedio}
            <td class="text-end">${(result_suma.toFixed(2))/problems_array.length}</td>
        `
        document.getElementById('thead_matriz_promedio').innerHTML = render_thead
        document.getElementById('tbody_matriz_promedio').innerHTML = render_tbody_promedio
    }

