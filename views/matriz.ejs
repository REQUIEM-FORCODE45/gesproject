    async function generate_tree_problems(){
        let errors = []
        if(causas_indirectas[0].title != ''){
            await causas_indirectas.forEach(async item => {
                let dat = document.getElementById(`select_causas_indirectas_${item.index}`).value
                if(dat == 0){
                    errors.push({message:`Debe vincular <span class="fw-bold">${item.index}</span> a una causa DIRECTA`})
                    document.getElementById(`select_causas_indirectas_${item.index}`).classList.add("is-invalid");
                } else{
                    document.getElementById(`select_causas_indirectas_${item.index}`).classList.remove("is-invalid");
                }
            })
        }
        if(causas_tercer_orden[0].title != ''){
            await causas_tercer_orden.forEach(async item => {
                let dat = document.getElementById(`select_causas_tercer_orden_${item.index}`).value
                if(dat == 0){
                    errors.push({message:`Debe vincular <span class="fw-bold">${item.index}</span> a una causa INDIRECTA`})
                    document.getElementById(`select_causas_tercer_orden_${item.index}`).classList.add("is-invalid");
                } else{
                    document.getElementById(`select_causas_tercer_orden_${item.index}`).classList.remove("is-invalid");
                }
            })
        }
        console.log(errors)
        if(errors.length != 0){
            console.log('hay errores')
            errors_generate_tree(errors)
        } else {
            console.log('NO hay errores')
            let causas_directas_arr = []
            if(causas_directas[0].title != ''){
                causas_directas.forEach(causa => {
                    
                    let causas_indirectas_arr = []
                    if(causas_indirectas[0].title != ''){
                        causas_indirectas.forEach( indirecta => {
                            
                            let causas_tercer_orden_arr = []
                            if(causas_tercer_orden[0].title != ''){
                                causas_tercer_orden.forEach( tercer => {
                                    let dat3 = document.getElementById(`select_causas_tercer_orden_${tercer.index}`).value
                                    if(indirecta.index == dat3){
                                        causas_tercer_orden_arr.push(tercer)
                                    } 
                                })
                                indirecta.tercer_orden = causas_tercer_orden_arr
                            }

                            let dat = document.getElementById(`select_causas_indirectas_${indirecta.index}`).value
                            if(causa.index == dat){
                                causas_indirectas_arr.push(indirecta)
                            }
                        })
                    }
                    let causas_directas_obj = {
                        title: causa.title,
                        description: causa.description,
                        index: causa.index,
                        sigla: causa.sigla,
                        result_col: causa.result_col,
                        result_fila: causa.result_fila,
                        causas_indirectas: causas_indirectas_arr
                    }
                    causas_directas_arr.push(causas_directas_obj)
                })
            }

            console.log('efectos')
            console.log(efectos)
            let other_efect = []
      
            let problem_tree = {
                central_problem,
                causas: causas_directas_arr,
                efectos
                // efectos: efectos[0].title != '' ? `${efectos}`:`${other_efect}`
            }

            console.log('problem_tree')
            console.log(problem_tree)

            try{
                let url_api = `/tree/register/${vig_tec_id}`
                axios.post(url_api, {
                    problem_tree
                })
                .then(function(response) {
                    console.log(response)
                    Swal.fire({
                        icon: 'success',
                        title: 'Arbol Generado',
                        text: 'Arbol de problemas se genero correctamente!',
                        footer: `<a href="/tree/${vig_tec_id}/${response.data.length_tree}">Ver arbol de problemas</a>`
                    })
                })
                .catch(function (error){
                    console.log(error.response)
                })
            } catch (error){
                console.log(error)
            }
        }
    }

