<!-- Script functions front -->
<script>
    let vig_tec_id = document.getElementById('vig_tec_id').value
    let art_state_id = document.getElementById('art_state_id').value
    let user_id = document.getElementById('user_id').value
    let problem_data = []
    let problems_array_global = []

    function alert_success(message) {

        let alert = `
            <div class="alert alert-success d-flex align-items-center alert-dismissible fade show" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:"><use xlink:href="#check-circle-fill"/></svg>
                <div>
                    ${message}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        document.getElementById('alerts').innerHTML += alert

        $(".alert").delay(3000).slideUp(0, function() {
            $(this).alert('close');
        });

    }

    function alert_danger(message) {
        let alert = `
            <div class="alert alert-danger d-flex align-items-center alert-dismissible fade show" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:"><use xlink:href="#check-circle-fill"/></svg>
                <div>
                    ${message}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        document.getElementById('alerts').innerHTML += alert
        $(".alert").delay(3000).slideUp(0, function() {
            $(this).alert('close');
        });
    }

    async function get_all_problems() {
        console.log('call data')
        let url = '/matriz/problems/' + vig_tec_id + '/' + art_state_id;
        axios.get(url)
            .then(function(response) {
                let jsonData = response.data.artState
                console.log(response)
                let problems_array = jsonData.problems
                let tree = response.data.tree ?? {}

                problems_array_global = jsonData.problems
                
                let render_problems = ''

                problems_array.forEach((problem, i) => {
                    render_problems += `
                        <tr title="${problem.description}">
                            <td>P${i+1}</td>
                            <td>${problem.sigla}</td>
                            <td><p class="lh-2 lim-text mb-1">${problem.title}</p></td>
                        <tr>
                        `
                })

                
                
                document.getElementById('problems_list').innerHTML += render_problems
                render_matriz_user()
                render_matriz_promedio(problems_array)
                render_tree_problems(tree)
                render_tree_objetivos(tree)
               
            }).catch(function(error){
                console.log(error)
            })
        // Close axios
    }

    async function post_value_problem(problem, id_fila) {
        console.log('---- post change value id problem ----')

        // Variables del POST
        let id_problem = id_fila
        let id_problem_col = problem.id
        let value = problem.value
        
        // variables de resultado 
        let result_col = document.getElementById('fila_result_' + id_fila)
        let result = 0

        // fila valor de problemas
        let fila_problem = document.getElementById('fila_problem_' + id_fila)

        // captura de valor de cada input
        let values_input = fila_problem.getElementsByTagName('input')
        // console.log(values.length)

        let url_api = '/matriz/value/' + vig_tec_id + '/' + art_state_id
            axios.post(url_api, {
                id_problem,
                id_problem_col,
                value,
            })
            .then(function(response) {
                console.log(response)
                let message = response.data.message
                if(response.status == 200){
                    for (let index = 0; index < values_input.length; index++) {
                        const value_problem = values_input[index].value;
                        const id_problema = values_input[index].id;
                        result += parseInt(value_problem)
                    }

                    result_col.innerHTML = result

                } else {
                    alert_danger(message)
                }
                
            })
            .catch(function(error){
                console.log(error)
            })

    }

    // --- # FUNCTION PROBLEMS -ART STATE # ---- //
    async function post_problem_register() {
        console.log('REGISTRO DE PROBLEMAS')
        console.log(art_state_id)
        
        let title = document.getElementById('title').value
        let sigla = document.getElementById('sigla').value
        let description = document.getElementById('description').value
        let render_problems = ''

        if(title !='' && sigla != '' && description != ''){

            let url_api = '/problem/register/' + vig_tec_id + '/' + art_state_id
            axios.post(url_api, {
                title,
                sigla,
                description,
            })
            .then(function(response) {
                console.log(response)
                let res = response.data
                let message = res.message
                if(response.status == 200){
                    document.getElementById('title').value = ''
                    document.getElementById('sigla').value = ''
                    document.getElementById('description').value = ''

                    render_problems += `
                        <tr title="${res.problema.description}">
                            <td>P${res.length_problemas}</td>
                            <td>${res.problema.sigla}</td>
                            <td><p class="lh-2 lim-text mb-1">${res.problema.title}</p></td>
                        <tr>
                        `
                    problems_array_global.push(res.problema)
                    document.getElementById('problems_list').innerHTML += render_problems
                    alert_success(message);
                    // update_list_problems();
                    render_matriz_user();
                    $("#ProblemaModal").modal("hide")
                } else {
                    alert_danger(message)
                }
                
            })
            .catch(function(error){
                console.log(error)
            })
        } else {
            console.log('NO PASA')
        }
        
    }   

    // --- # END FUNCTION PROBLEMS -ART STATE # ---- //

// --- # ------ GET DATA PROBLEMAS ----- # --- //
    async function get_data_problems(){
        console.log('get data problems')
        let url = '/matriz/problems/' + vig_tec_id + '/' + art_state_id;
        axios.get(url)
            .then( function (response) { 
                let jsonData = response.data.artState
                console.log(jsonData)
                let problems_array = jsonData.problems
                render_matriz_promedio(problems_array)
            })
            .catch( function (error) {
                console.log(error)
            })
    }
// --- # ---- END GET DATA PROBLEMAS --- # --- //

// --- # ------ PROCESS MATRIZ USUARIO ----- # --- //
    async function render_matriz_user(){

        let render_thead = `
            <th class="text-center">#</th>
            <th class="text-center">Sigla</th>
        `
        let render_tbody = ''
        let problems_array = problems_array_global
        problems_array.forEach((problem, i) => {
            
            render_thead += `
                <th class="text-center" style="min-width: 100px;" title="${problem.title}">
                    P${i+1}-${problem.sigla}
                </th>
            `
            let casillas = ''
            let result_col = 0
            let reg_user = problem.reg_users.find(user => user.user_id == user_id)
            // if(reg_user){
                
            for (let index = 0; index < problems_array.length; index++) {
                let valueExist
                
                if(reg_user){
                    valueExist = reg_user.values.find(problema => problema.id_problem_col == problems_array[index]._id)
                }
                if(index == i){
                    casillas += `
                    <td>
                        <input type="number" class="form-control bg-danger text-center" value="0" disabled>
                    </td>`
                } else {
                    if(reg_user){
                        let value_problem = 0
                        if(valueExist){
                            value_problem = parseInt(valueExist.value)
                            result_col += value_problem 
                        }
                        casillas += `
                        <td>
                            <input type="number" class="form-control text-center" id="${problems_array[index]._id}" name="" value="${value_problem}" min="0" max="3" onchange="post_value_problem(this, '${problem._id}')"
                            title="Qué tanto influye P${i+1}-${problem.title}, SOBRE P${index+1}-${problems_array[index].title}">
                        </td>`
                    } else {
                        casillas += `
                        <td>
                            <input type="number" class="form-control text-center" id="${problems_array[index]._id}" name="" value="0" min="0" max="3" onchange="post_value_problem(this, '${problem._id}')"
                            title="Qué tanto influye P${i+1}-${problem.title}, SOBRE P${index+1}-${problems_array[index].title}">
                        </td>`
                    }
                    
                }
            }

            render_tbody += `
                <tr id="fila_problem_${problem._id}">
                    <th class="text-center">P${i+1}</th>
                    <td title="${problem.title}"><p class="lh-2 lim-text mb-1">${problem.sigla}</p></td>
                    ${casillas}
                    <td class="text-end" id="fila_result_${problem._id}">${result_col}</td>
                </tr>
            `
        })

        // obtener la sumatoria de las columnas
        let render_result_col = ''
        let result_fila_dependencia = 0
        for (let index = 0; index < problems_array.length; index++) {
            let result_fila = 0
            for (let j = 0; j < problems_array.length; j++) {
                let user_problem_find = problems_array[j].reg_users.find(user => user.user_id == user_id)
                if(user_problem_find){
                    let value_problem_find = user_problem_find.values.find(value => value.id_problem_col == problems_array[index]._id)
                    if(value_problem_find){
                        result_fila += parseInt(value_problem_find.value)
                    }
                }
            }

            result_fila_dependencia += result_fila
            render_result_col += `
                <td class="text-center">${result_fila}</td>
            `
        }
        
        render_thead += `<th class="text-center">Influencia</th>`
        render_tbody += `
            <tr>
                <th class="text-center" colspan="2">Dependencia</th>
                ${render_result_col}
                <td class="text-end">${result_fila_dependencia/problems_array.length}</td>
            </tr>
        `
        document.getElementById('thead_matriz').innerHTML = render_thead
        document.getElementById('tbody_matriz').innerHTML = render_tbody
    }

