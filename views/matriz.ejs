                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-ligth" data-bs-dismiss="modal">Cerrar</button>
          <button type="button" class="btn btn-primary" onclick="post_problem_register()" id="btn_add_problem">Añadir</button>
