    async function delete_problem(id_art_state, id_problem){
        Swal.fire({
            title: 'Estas seguro?',
            text: "Esta accion no se puede deshacer!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            cancelButtonText: 'Cancelar',
            confirmButtonText: 'Si, Eliminar!'
        }).then(async(result) => {
            if (result.isConfirmed) {
                try {
                    const respuesta = await axios.delete('/problem/delete/' + vig_tec_id + '/' + id_art_state + '/' + id_problem)
                    console.log(respuesta.status);
                    let message = respuesta.data.message
                    if(respuesta.status == 200){
                        alert_success(message)
                        last_id_referent = ''
                        document.getElementById('div_referent').innerHTML = ''
                        get_all_referents();
                    } else {
                        message += respuesta.status
                        alert_danger(message)
                    }
                    
                } catch (error) {
                    console.log(error)
                    Swal.fire(
                        'Error!',
                        'No se pudo eliminar',
                        'error'
                    )
                }
            } else {
                Swal.fire(
                    'Cancelado!',
                    '',
                    'error'
                )
            }
        })
    }

