    // -- # ----- UPDATE INFO VIG TEC ----- # -- //
    async function update_ficha() {
        
        let title_ficha = document.getElementById('title_ficha').value
        let area_tema = document.getElementById('area_tema_ficha').value
        let sector = document.getElementById('sector').value
        let poblacion = document.getElementById('poblacion').value
        let keywords = document.getElementById('keywords').value

        let btn = document.getElementById('btn_update_vig_tec')
        btn.disabled = true;
        btn.innerHTML = `
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        `

        if(title_ficha !='' && area_tema != '' && keywords != ''){
            
            axios.put('/vigTec/update/' + vig_tec_id, {
                title_ficha,
                area_tema,
                sector,
                poblacion,
                keywords
            })
            .then(function(response) {
                console.log(response)
                let message = response.data.message
                if(response.status == 200){
                    btn.disabled = false;
                    btn.innerHTML = `Editar`
                    $("#modal_edit_ficha_vig_tec").modal("hide")
                    alert_success(message)
                    get_all_referents()
                } else {
                    alert_danger(message)
                }
                
            })
            .catch(function(error){
                console.log(error)
            })
        } else {
            console.log('NO PASA')
            btn.disabled = false;
            btn.innerHTML = `Editar`
            const form = document.getElementById('form_update_vig_tec')
            Array.from(form.elements).forEach(element => {
                if (!element.value) {
                    element.classList.add("is-invalid");
                    element.classList.remove("is-valid");
                    valueGuardar = false
                } else {
                    element.classList.remove("is-invalid");
                    element.classList.add("is-valid");
                    valueGuardar = true

                }
            });
            alert_danger('Complete todos los campos obligatorios por favor')
        }
        
    }

    // -- # --- END UPDATE INFO VIG TEC --- # -- //

    // -- # ----- DELETE VIGILANCIA TECNOLOGICA ----- # -- //
    async function delete_ficha(){
        Swal.fire({
            title: 'Estas seguro?',
            text: "Esta accion no se puede deshacer!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            cancelButtonText: 'Cancelar',
            confirmButtonText: 'Si, Eliminar!'
        }).then(async(result) => {
            if (result.isConfirmed) {
                try {
                    const respuesta = await axios.delete('/vigTec/delete/' + vig_tec_id)
                    console.log(respuesta.status);
                    let message = respuesta.data.message
                    if(respuesta.status == 200){
                        window.location.href = "/dashboard-vig-tec";
                    } else {
                        message += respuesta.status
                        alert_danger(message)
                    }
                    
                } catch (error) {
                    console.log(error)
                    Swal.fire(
                        'Error!',
                        'No se pudo eliminar',
                        'error'
                    )
                }
            } else {
                Swal.fire(
                    'Cancelado!',
                    '',
                    'error'
                )
            }
        })
    }

    // -- # ----- DELETE VIGILANCIA TECNOLOGICA ----- # -- //

