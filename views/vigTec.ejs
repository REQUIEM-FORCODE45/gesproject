    function add_extra_camp(){
        let titulo_extra_camp = document.getElementById('title_extra_camp')
        let desc_extra_camp = document.getElementById('descripcion_extra_camp')
        let add_camp = true

        if(!titulo_extra_camp.value){
            titulo_extra_camp.classList.add("is-invalid");
            titulo_extra_camp.classList.remove("is-valid");
            document.getElementById('alert_message_extra_camp').hidden = false
            add_camp = false
        } else {
            titulo_extra_camp.classList.add("is-valid");
            titulo_extra_camp.classList.remove("is-invalid");
        }
     
        if(!desc_extra_camp.value){
            desc_extra_camp.classList.add("is-invalid");
            desc_extra_camp.classList.remove("is-valid");
            document.getElementById('alert_message_extra_camp').hidden = false
            add_camp = false
        } else {
            desc_extra_camp.classList.add("is-valid");
            desc_extra_camp.classList.remove("is-invalid");
        }

        if(add_camp){
            let extra_camp_obj = {
                'title': titulo_extra_camp.value,
                'description': desc_extra_camp.value,
                'index': art_state_extra_camps.length
            }
            art_state_extra_camps.push(extra_camp_obj)
            desc_extra_camp.value = ''
            desc_extra_camp.classList.remove("is-valid");
            titulo_extra_camp.value = ''
            titulo_extra_camp.classList.remove("is-valid");
            document.getElementById('alert_message_extra_camp').hidden = true

            render_extra_camps()
        }
    }

