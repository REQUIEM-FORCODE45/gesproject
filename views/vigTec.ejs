                <p class="text-center">${render_keys}</p>
                <p class="">Sector: ${DataGlobal.sector} - Poblacion: ${DataGlobal.poblacion}</p>
                <p class="fw-bold">Documentros registrados: ${DataGlobal.referents.length}</p>
                <div class="col-10 x_content mb-3 pe-4">
                    <canvas id="chart_referents"></canvas>
                </div>
                <p>Rango de los años de los documentos almacenados: 
                    <span class="fw-bold">Minimo: </span>${Math.min(...años)} -
                    <span class="fw-bold">Maximo: </span>${Math.max(...años)}
                </p>
                <p>Autores de los documentos consultados: <span class="fw-bold">${authors}</span></p>
                <p>Promedio de autores por documento: <span class="fw-bold">${(authors/DataGlobal.referents.length).toFixed(2)}</span></p>
                <p>Países de los documentos consultados: <span class="fw-bold">${render_paises}</span></p>
                <div class="col-10 x_content mb-3 pe-4">
                    <canvas id="chart_categorization"></canvas>
                </div>
                <p>Temas de los documentos consultados: <span class="fw-bold">${render_temas}</span></p>
            </div>
        `
        document.getElementById('div_report').innerHTML = render_report

        $("#report_modal").modal("show") 

        render_chart_referents()
        render_chart_categorization()
    }

    function render_chart_referents(){
        let data_referents = []

        DataGlobal.referents.forEach(ref => {

            let doc = data_referents.find(data => data.type == ref.doc_type)
            if(doc){
                doc.valu = doc.valu + 1
            }else{
                data_referents.push({
                    type: ref.doc_type,
                    valu: 1
                })
            }
            
        })

        console.log(data_referents)

        let label_arr = []
        let value_arr = []
        let backgroundColor_arr = ['rgb(255, 0, 0, 0.2)','rgb(0, 255, 0, 0.2)', 'rgb(0, 0, 255, 0.2)', 'rgb(255, 255, 0, 0.2)', 'rgb(0, 255, 255, 0.2)', 'rgb(255, 0, 255, 0.2)',
        'rgb(170, 0, 0, 0.2)', 'rgb(0, 170, 0, 0.2)', 'rgb(0, 0, 170, 0.2)', 'rgb(0, 255, 170, 0.2)', 'rgb(255, 0, 170, 0.2)']
        let borderColor_arr = ['rgb(255, 0, 0, 1)', 'rgb(0, 255, 0, 1)', 'rgb(0, 0, 255, 1)', 'rgb(255, 255, 0, 1)', 'rgb(0, 255, 255, 1)', 'rgb(255, 0, 255, 1)', 
        'rgb(170, 0, 0, 1)', 'rgb(0, 170, 0, 1)', 'rgb(0, 0, 170, 1)', 'rgb(0, 255, 170, 1)', 'rgb(255, 0, 170, 1)']
        data_referents.forEach(data => {
            label_arr.push(data.type)
            value_arr.push(data.valu)
        })

        var ctx = document.getElementById("chart_referents").getContext("2d");

        var mybarChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: label_arr,
                datasets: [
                    {
                        backgroundColor: backgroundColor_arr,
                        borderColor: borderColor_arr,
                        data: value_arr
                    }
                ]
            },
            options: {
                legend: {display: false},
                title: {
                    display: true,
                    text: "Tipo de documentos registrados"
                },
                scales:{
                    yAxes:[{
                        ticks: { 
                            beginAtZero: true,
                            stepSize: 0.5
                        }
                    }]
                },
            }
        });
    }

    function render_chart_categorization(){
        let data_categori = []

        DataGlobal.referents.forEach(ref => {
            if(ref.categorization != ''){
                let doc = data_categori.find(data => data.type == ref.categorization)
                console.log(doc)
                if(doc){
                    doc.valu = doc.valu + 1
                }else{
                    data_categori.push({
                        type: ref.categorization,
                        valu: 1
                    })
                }
            }
