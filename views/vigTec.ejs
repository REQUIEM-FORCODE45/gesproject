                        </div>
                    </div>
                    <div class="col-12 mb-2" hidden>
                        <div class="form-floating">
                            <textarea class="form-control" id="observaciones_art_state" name="" placeholder="Observaciones estado del arte" style="height: 100px"></textarea>
                            <label for="observaciones_art_state">Observaciones estado del arte</label>
                        </div>
                    </div>
                    <div class="col-12 mb-2">
                        <div class="form-floating">
                            <textarea class="form-control" id="description_art_state" name="" placeholder="Descripción estado del arte (Análisis propio)" style="height: 100px"></textarea>
                            <label for="description_art_state">Descripción estado del arte (Análisis propio)</label>
                        </div>
                    </div>
                    <div class="col-12" hidden>
                        <div class="form-floating">
                            <textarea class="form-control" id="conclusiones_art_state" name="" placeholder="Conclusiones estado del arte" style="height: 100px"></textarea>
                            <label for="conclusiones_art_state">Conclusiones estado del arte</label>
                        </div>
                    </div> 
                </form>

                <div class="border border-warning border-3 rounded pb-1">
                    <p class="text-warning fw-bold ms-4">Agregar campo extra <span title="Agregar campos extra para complementar el estado del arte, estos se veran reflejados en la pestaña de estado del arte">
                        <i class="fas fa-question-circle"></i></span>
                    </p>
                    <div class="row">
                        <div class="col-11">
                            <div class="col-12 mb-1">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="title_extra_camp" placeholder="Titulo campo extra" required>
                                    <label for="title_extra_camp">Titulo campo extra</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea class="form-control" id="descripcion_extra_camp" name="" placeholder="Descripción campo extra" style="height: 100px"></textarea>
                                    <label for="descripcion_extra_camp">Descripción campo extra</label>
                                </div>
                            </div> 
                        </div>
                        <div class="col-1 d-grid gap-2">
                            <button type="button" class="btn btn-warning" title="Agregar campo extra" onclick="add_extra_camp()"><i class="fas fa-plus"></i></button>
                        </div>
                    </div>
                    <p class="fst-italic text-danger" id="alert_message_extra_camp" hidden>Para agregar un campo extra debe completar titulo y descripcion del campo.</p>
                    
                    <!-- TABLE REFERENTS -->
                    <div class="table-responsive mx-auto wow fadeInUp mt-1 mb-1" id="table_extra_camps" hidden>
                        <table class="table table-centered table-hover table-sm mb-0">
                            <thead class="table-dark align-middle">
                                <tr>
                                    <th class="text-center" style="max-width: 200px;">Titulo</th>
                                    <th class="text-center">Descripción</th>
                                    <th class="text-center" style="width: 50px;">Eliminar</th>
                                </tr>
                            </thead>
                            <tbody id="tbody_extra_camps">
                                <!-- CONTENT REFERENTS -->
                            </tbody>
                        </table>
                    </div>
                    <!--  END TABLE REFERENTS -->
                </div> 

            </div>
        </div>
    
        <div class="modal-footer">
            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
            <button class="btn btn-primary" type="button" id="btn_post_art_state" onclick="post_art_state()">Generar</button>
            <button class="btn btn-info" type="button" id="btn_update_art_state" onclick="update_art_state()" hidden><i class="far fa-save"></i> Guardar</button>
        </div>

      </div>
    </div>
</div>
