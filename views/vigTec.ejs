    function import_bit_text() {
        authors = []

        let BibTex = document.getElementById('BibTex').value
        console.log(BibTex)

        let BibTex_arr = BibTex.split('\n')
        console.log(BibTex_arr)

        try {

            BibTex_arr.forEach(element => {
                let data = element.split('=')
                data[0] = data[0].trim()

                if(!data[1]) return
                data[1] = data[1].replace("{", "");
                data[1] = data[1].replace("}", "");

                console.log(data[1])
                if(data[0] == 'title'){
                    document.getElementById('doc_title').value = data[1]
                } else if(data[0] == 'journal'){
                    data[1] = data[1].replace(",", "");
                    document.getElementById('institution_entity').value = data[1]
                } else if(data[0] == 'year'){
                    data[1] = data[1].replace(",", "");
                    document.getElementById('year_publication').value = data[1]
                } else if(data[0] == 'issn'){
                    document.getElementById('ISDN_ISBN').value = data[1]
                } else if(data[0] == 'doi'){
                    document.getElementById('DOI').value = data[1]
                } else if(data[0] == 'url'){
                    document.getElementById('doc_URL').value = data[1]
                } else if(data[0] == 'abstract'){
                    document.getElementById('abstract').value = data[1]
                } else if(data[0] == 'author'){
                    let text = data[1]
                    if(!text) return
                    while (text.indexOf(',') != -1){
                        console.log(text.indexOf(','))
                        text = text.replace(",", "");
                    }
                    let authors_this = text.split(' and ')
                    authors_this.forEach((item, i) => {
                        let aut = item.split(' ')
                        console.log('add author')
                        let author = {
                            name: aut[0],
                            lastname: aut[1],
                            _id: i
                        }

                        authors.push(author)
                    })
                    render_authors()
                    console.log(authors)
                    // document.getElementById('abstract').value = text
                } 
            })

            $("#referentModal").modal("show") 
            $("#BibTex_modal").modal("hide") 
            document.getElementById('BibTex').value = ''
        } catch (error) {
            console.log(error)   
        }
    }

