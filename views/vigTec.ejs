    async function update_problem(data){
        let datas = data.split(',')
        let id_art_state = datas[0]
        let id_problem = datas[1]

        console.log('id estado arte: ' + id_art_state + ' - id_ problema: ' + id_problem)

        let title = document.getElementById('title').value
        let sigla = document.getElementById('sigla').value
        let description = document.getElementById('description').value

        let btn = document.getElementById('btn_update_problem')
        btn.disabled = true;
        btn.innerHTML = `
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        `

        if(title !='' && sigla != '' && description != ''){
           
            let url_api = '/problem/update/' + vig_tec_id + '/' + id_art_state + '/' + id_problem
            axios.put(url_api, {
                title,
                sigla,
                description,
            })
            .then(function(response) {
                console.log(response)
                let message = response.data.message
                if(response.status == 200){
                    title = ''
                    sigla = ''
                    description = ''
                    
                    btn.disabled = false;
                    btn.innerHTML = `Editar`
                    document.getElementById('btn_add_problem').style.display = ''; // show
                    document.getElementById('btn_update_problem').style.display = 'none'; // hide

                    alert_success(message);
                    $("#ProblemaModal").modal("hide")
                    get_all_problems(id_art_state);
                } else {
                    alert_danger(message)
                }
                
            })
            .catch(function(error){
                console.log(error)
            })
        } else {
            console.log('NO PASA')
            btn.disabled = false;
            btn.innerHTML = `Editar`
        }

    }

