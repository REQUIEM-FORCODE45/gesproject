    async function print_report(){
        const options = {
            margin: 1,
            filename: 'report.pdf',
            image: { 
                type: 'jpeg', 
                quality: 0.98 
            },
            html2canvas: { 
                scale: 2 
            },
            jsPDF: { 
                unit: 'in', 
                format: 'letter', 
                orientation: 'portrait' 
            }
        }
        let element = document.getElementById('div_report')
        let worker = await html2pdf().from(element).set(options).toPdf().output('blob').then((data) => {
            // console.log(data)
            let fileURL = URL.createObjectURL(data);
            window.open(fileURL);
        })
    }

    // ---------------------------------------------------------------------------------------------- //

    window.onload = function() {
        get_all_referents();
        
	}
</script>
