        })

        var ctx = document.getElementById("chart_categorization").getContext("2d");

        var mybarChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: label_arr,
                datasets: [
                    {
                        backgroundColor: backgroundColor_arr,
