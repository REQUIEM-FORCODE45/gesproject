    function fast_edit_referent_item(id_referent, edit_type){

        let div_content  = document.getElementById(edit_type + '_' + id_referent)
        let texto = div_content.getElementsByTagName("p")[0].innerText
        let array_texto = []
        
        if(edit_type != 'doc_title' && edit_type != 'abstract' && edit_type != 'doc_URL'){
            array_texto = texto.split(':')
            console.log('sepr :_')
            if(array_texto.length > 2){
                console.log('in for')
                texto = ''
                for (let index = 1; index < array_texto.length; index++) {
                    if(index == array_texto.length-1){
                        texto += array_texto[index]
                    } else {
                        texto += array_texto[index] + ':'
                    }
                }
            } else {
                console.log('no in for')
                texto = (array_texto[1])
            }
        } else {
            array_texto.push('other')
        }

        texto = texto.trim()

        if (edit_type == 'year_publication'){
            div_content.innerHTML = `
            <div class="row">
                <div class="col-10">
                    <input type="number" class="form-control" id="edit_${edit_type}_${id_referent}" value="${texto}" min="1900" max="2023">
                </div>
                <div class="col-1">
                    <button class="btn btn-sm btn-primary mt-1" onclick="update_referent('${id_referent}', '${edit_type}', '${array_texto[0]}')"><i class="far fa-save"></i></button>
                </div>
            </div>
            `
        } else if(edit_type == 'doc_title' || edit_type == 'abstract') {
            div_content.innerHTML = `
            <div class="row">
                <div class="col-10">
                    <textarea class="form-control" style="height: 100px" id="edit_${edit_type}_${id_referent}">${texto}</textarea>
                </div>
                <div class="col-1">
                    <button class="btn btn-sm btn-primary mt-1" onclick="update_referent('${id_referent}', '${edit_type}', '${array_texto[0]}')"><i class="far fa-save"></i></button>
                </div>
            </div>
            `
        } else if (edit_type == 'doc_URL') {
            let urle = div_content.getElementsByTagName("a")[0].href
            div_content.innerHTML = `
            <div class="row">
                <div class="col-10">
                    <input type="text" class="form-control" id="edit_${edit_type}_${id_referent}" value="${urle}">
                </div>
                <div class="col-1">
                    <button class="btn btn-sm btn-primary mt-1" onclick="update_referent('${id_referent}', '${edit_type}', '${array_texto[0]}')"><i class="far fa-save"></i></button>
                </div>
            </div>
            `
        } else {
            div_content.innerHTML = `
            <div class="row">
                <div class="col-10">
                    <input type="text" class="form-control" id="edit_${edit_type}_${id_referent}" value="${texto}">
                </div>
                <div class="col-1">
                    <button class="btn btn-sm btn-primary mt-1" onclick="update_referent('${id_referent}', '${edit_type}', '${array_texto[0]}')"><i class="far fa-save"></i></button>
                </div>
            </div>
            `
        }
    }   

