<input type="hidden" name="" id="rol_usuario" value="<%= user.rol %>">
<div class="container mt-2">
    <div id="alerts"></div>
    <div class="row g-0 feature-row bg-white">
        <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.1s">
            <div class="feature-item border h-100 p-5">
                <div class="btn-square bg-light rounded-circle mb-4" style="width: 64px; height: 64px;">
                    <i class="fas fa-users fa-lg" style="color: #2461cc;"></i>
                </div>
                <h5 class="mb-3" id="all_users">...</h5>
                <p class="mb-0">Usuarios registrados en el aplicativo</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.3s">
            <div class="feature-item border h-100 p-5">
                <div class="btn-square bg-light rounded-circle mb-4" style="width: 64px; height: 64px;">
                    <i class="fas fa-users-cog fa-lg text-success"></i>
                </div>
                <h5 class="mb-3" id="admin_users">...</h5>
                <p class="mb-0">Usuarios registrados como Adiminstradores </p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.5s">
            <div class="feature-item border h-100 p-5">
                <div class="btn-square bg-light rounded-circle mb-4" style="width: 64px; height: 64px;">
                    <i class="fas fa-user-check fa-lg" style="color: #2461cc;"></i>
                </div>
                <h5 class="mb-3" id="active_users">...</h5>
                <p class="mb-0">Usuarios activos</p>
            </div>
        </div>
        <div class="col-md-6 col-lg-3 wow fadeIn" data-wow-delay="0.7s">
            <div class="feature-item border h-100 p-5">
                <div class="btn-square bg-light rounded-circle mb-4" style="width: 64px; height: 64px;">
                    <i class="fas fa-user-times fa-lg text-danger"></i>
                </div>
                <h5 class="mb-3" id="block_users">...</h5>
                <p class="mb-0">Usuarios bloqueados</p>
            </div>
        </div>
    </div>
    <!-- TABLE USERS -->
    <div class="table-responsive mx-auto wow fadeInUp mt-2 mb-2 bg-white">
        <table class="table table-centered table-hover mb-0">
            <thead class="table-dark align-middle">
                <tr>
                    <th class="text-center">Rol</th>
                    <th class="text-center" style="max-width: 200px;">Nombre</th>
                    <th class="text-center">Email</th>
                    <th class="text-center">Estado</th>
                    <th class="text-center">Opciones</th>
                </tr>
            </thead>
            <tbody id="users_list">
                <!-- CONTENT USERS -->
            </tbody>
        </table>
    </div>
    <!--  END TABLE USERS -->
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

<script>
    let rol_usuario = document.getElementById('rol_usuario').value

    function alert_success(message) {
        let alert = `
            <div class="alert alert-success d-flex align-items-center alert-dismissible fade show" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Success:"><use xlink:href="#check-circle-fill"/></svg>
                <div>
                    ${message}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        document.getElementById('alerts').innerHTML += alert

        $(".alert").delay(3000).slideUp(0, function() {
            $(this).alert('close');
        });
    }

    function alert_danger(message) {
        let alert = `
            <div class="alert alert-danger d-flex align-items-center alert-dismissible fade show" role="alert">
                <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Danger:"><use xlink:href="#check-circle-fill"/></svg>
                <div>
                    ${message}
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        document.getElementById('alerts').innerHTML += alert

        $(".alert").delay(3000).slideUp(0, function() {
            $(this).alert('close');
        });
    }

    async function get_all_users() {
        let render_users = ''

        let all_users = 0
        let admin_users = 0
        let active_users = 0
        let block_users = 0

        let url = `users/all/users`
        axios.get(url)
        .then(function(response) {
            let jsonData = response.data
            // console.log(jsonData)
            if(jsonData.length != 0){
                all_users = jsonData.length
                jsonData.forEach((user, i) => {
                    if(user.rol != 'user'){
                        admin_users ++
                    }
                    if(user.state == 'active'){
                        active_users ++
                    } else {
                        block_users ++
                    }
                    render_users += `
                        <tr id="user_${user._id}">
                            <td class="text-center">
                                ${user.rol == 'user'? `
                                <i class="fas fa-user text-primary"></i> Usuario
                                `:`
                                <i class="fas fa-user-tie text-info"></i> Administrador
                                `}
                            </td>
                            <td>${user.name + ' ' + user.last_name }</td>
                            <td>${user.email}</td>
                            <td class="text-center">
                                ${user.state == 'active'? `
                                <i class="fas fa-dot-circle text-success"></i> Activo
                                `:`
                                <i class="fas fa-dot-circle text-danger"></i> Block
                                `}
                            </td>
                            <td class="text-center">
                                ${user.rol == 'user'? `
                                <button type="button" class="btn btn-outline-info" onclick="upgrade_admin('${user._id}')" title="Hacer administrador">
                                    <i class="fas fa-user-plus text-info"></i>
                                </button>
                                `:`
                                ${rol_usuario == 'superadmin'? `
                                <button type="button" class="btn btn-outline-danger" onclick="fall_admin('${user._id}')" title="Regresar a usuario">
                                    <i class="fas fa-user-minus text-danger"></i>
                                </button>
                                `:``}
                                `}
                                ${user.rol == 'user'? `
                                    ${user.state == 'active'? `
                                        <button type="button" class="btn btn-outline-warning" onclick="block_user('${user._id}')" title="Bloquear usuario">
                                            <i class="fas fa-user-slash text-warning"></i>
                                        </button>
                                        `:`
                                        <button type="button" class="btn btn-outline-primary" onclick="activate_user('${user._id}')" title="Activar usuario">
                                            <i class="fas fa-user-check text-primary"></i>
                                        </button>
                                    `}
                                `:``}
                            </td>
                        </tr>
                    `
                });
            }
            document.getElementById('users_list').innerHTML = render_users
            document.getElementById('all_users').innerHTML = `${all_users}`
            document.getElementById('admin_users').innerHTML = `${admin_users} - ${(admin_users/all_users)*100}%`
            document.getElementById('active_users').innerHTML = `${active_users} - ${(active_users/all_users)*100}%`
            document.getElementById('block_users').innerHTML = `${block_users} - ${(block_users/all_users)*100}%`

        })
        .catch(function(error){
            console.log(error)
        })
    }

    function update_date_user(user){
        document.getElementById(`user_${user._id}`).innerHTML = `
            <td class="text-center">
                ${user.rol == 'user'? `
                <i class="fas fa-user text-primary"></i> Usuario
                `:`
                <i class="fas fa-user-tie text-info"></i> Administrador
                `}
            </td>
            <td>${user.name + ' ' + user.last_name }</td>
            <td>${user.email}</td>
            <td class="text-center">
                ${user.state == 'active'? `
                <i class="fas fa-dot-circle text-success"></i> Activo
                `:`
                <i class="fas fa-dot-circle text-danger"></i> Block
                `}
            </td>
            <td class="text-center">
                ${user.rol == 'user'? `
                <button type="button" class="btn btn-outline-info" onclick="upgrade_admin('${user._id}')" title="Hacer administrador">
                    <i class="fas fa-user-plus text-info"></i>
                </button>
                `:`
                ${rol_usuario == 'superadmin'? `
                <button type="button" class="btn btn-outline-danger" onclick="fall_admin('${user._id}')" title="Regresar a usuario">
                    <i class="fas fa-user-minus text-danger"></i>
                </button>
                `:``}
                `}
                ${user.rol == 'user'? `
                    ${user.state == 'active'? `
                        <button type="button" class="btn btn-outline-warning" onclick="block_user('${user._id}')" title="Bloquear usuario">
                            <i class="fas fa-user-slash text-warning"></i>
                        </button>
                        `:`
                        <button type="button" class="btn btn-outline-primary" onclick="activate_user('${user._id}')" title="Activar usuario">
                            <i class="fas fa-user-check text-primary"></i>
                        </button>
                    `}
                `:``}
            </td>
        `
    }

    async function upgrade_admin(id_user){
        let url_api = `profile/${id_user}/rol`
        axios.put(url_api, {
            rol: 'admin'
        })
        .then(function(response) {
            console.log(response)
            let user = response.data.user
            update_date_user(user)
            alert_success(response.data.message)
        })
        .catch(function(error){
            console.log(error)
            alert_danger(error.response.data.message)
        })
    }

    async function fall_admin(id_user){
        let url_api = `profile/${id_user}/rol`
        axios.put(url_api, {
            rol: 'user'
        })
        .then(function(response) {
            console.log(response.data.message)
            let user = response.data.user
            update_date_user(user)
            alert_success(response.data.message)
        })
        .catch(function(error){
            console.log(error)
            alert_danger(error.response.data.message)
        })
    }

    async function block_user(id_user){
        let url_api = `profile/${id_user}/state`
        axios.put(url_api, {
            state: 'block'
        })
        .then(function(response) {
            console.log(response)
            let user = response.data.user
            update_date_user(user)
            alert_success(response.data.message)
        })
        .catch(function(error){
            console.log(error)
            alert_danger(error.response.data.message)
        })
    }

    async function activate_user(id_user){
        let url_api = `profile/${id_user}/state`
        axios.put(url_api, {
            state: 'active'
        })
        .then(function(response) {
            console.log(response)
            let user = response.data.user
            update_date_user(user)
            alert_success(response.data.message)
        })
        .catch(function(error){
            console.log(error)
            alert_danger(error.response.data.message)
        })
    }


    window.onload = function() {
        get_all_users();
	}
</script>