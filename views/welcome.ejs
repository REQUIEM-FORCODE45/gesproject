<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-5 fw-bold mb-3" style="color: #0A2351;">
                <i class="fas fa-project-diagram me-3" style="color: #0D5EC1;"></i>Gesproject
            </h1>
            <p class="lead" style="color: #0D5EC1;">
                Accede a recursos, publicaciones y oportunidades para investigación e innovación
            </p>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-lg hover-shadow" style="border-top: 4px solid #0A2351;">
                <div class="card-header text-white py-3" style="background-color: #0A2351;">
                    <h4 class="mb-0 text-white">
                        <i class="fas fa-book-open me-2"></i>Bibliotecas Virtuales
                    </h4>
                </div>
                <div class="card-body" style="background-color: #FFFFFF;">
                    <p class="card-text mb-4">Acceso gratuito a bases de datos y repositorios académicos:</p>
                    <div class="list-group list-group-flush">
                        <a href="https://www.scielo.org" target="_blank" class="list-group-item list-group-item-action border-0 py-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-external-link-alt me-3" style="color: #0D5EC1;"></i>
                                <div>
                                    <h6 class="mb-1">SciELO Colombia</h6>
                                    <small class="text-muted">Biblioteca científica electrónica</small>
                                </div>
                            </div>
                        </a>
                        <a href="https://www.redalyc.org" target="_blank" class="list-group-item list-group-item-action border-0 py-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-external-link-alt me-3" style="color: #0D5EC1;"></i>
                                <div>
                                    <h6 class="mb-1">Redalyc</h6>
                                    <small class="text-muted">Revistas científicas de América Latina</small>
                                </div>
                            </div>
                        </a>
                        <a href="https://doaj.org" target="_blank" class="list-group-item list-group-item-action border-0 py-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-external-link-alt me-3" style="color: #0D5EC1;"></i>
                                <div>
                                    <h6 class="mb-1">DOAJ</h6>
                                    <small class="text-muted">Directorio de revistas de acceso abierto</small>
                                </div>
                            </div>
                        </a>
                        <a href="https://www.dof.gob.mx" target="_blank" class="list-group-item list-group-item-action border-0 py-3">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-external-link-alt me-3" style="color: #0D5EC1;"></i>
                                <div>
                                    <h6 class="mb-1">Google Scholar</h6>
                                    <small class="text-muted">Motor de búsqueda de literatura académica</small>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="mt-4">
                        <button class="btn w-100" style="background-color: #EFF3FB; color: #0A2351;">
                            <i class="fas fa-plus-circle me-2"></i>Ver más bibliotecas
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-lg hover-shadow" style="border-top: 4px solid #0D5EC1;">
                <div class="card-header text-white py-3" style="background-color: #0D5EC1;">
                    <h4 class="mb-0 text-white">
                        <i class="fas fa-newspaper me-2"></i>Revistas Científicas
                    </h4>
                </div>
                <div class="card-body" style="background-color: #FFFFFF;">
                    <p class="card-text mb-4">Publicaciones indexadas de impacto para investigación:</p>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Nature</h6>
                                <span class="badge" style="background-color: #EFF3FB; color: #0D5EC1;">Q1</span>
                            </div>
                            <small class="text-muted">Multidisciplinario · Factor de impacto: 42.778</small>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Science</h6>
                                <span class="badge" style="background-color: #EFF3FB; color: #0D5EC1;">Q1</span>
                            </div>
                            <small class="text-muted">Ciencias generales · Factor: 41.845</small>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">IEEE Transactions</h6>
                                <span class="badge" style="background-color: #EFF3FB; color: #0D5EC1;">Q1</span>
                            </div>
                            <small class="text-muted">Ingeniería y tecnología · Varias disciplinas</small>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">Revista Colombiana</h6>
                                <span class="badge" style="background-color: #EFF3FB; color: #0D5EC1;">Q2</span>
                            </div>
                            <small class="text-muted">Tecnología e Innovación · Indexada SCOPUS</small>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button class="btn w-100" style="background-color: #EFF3FB; color: #0D5EC1;">
                            <i class="fas fa-search me-2"></i>Buscar más revistas
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100 border-0 shadow-lg hover-shadow" style="border-top: 4px solid #0A2351;">
                <div class="card-header text-white py-3" style="background-color: #0A2351;">
                    <h4 class="mb-0 text-white">
                        <i class="fas fa-bullhorn me-2"></i>Convocatorias Colombia
                    </h4>
                </div>
                <div class="card-body" style="background-color: #FFFFFF;">
                    <p class="card-text mb-4">Oportunidades de financiamiento para proyectos:</p>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">MinCiencias</h6>
                                <small class="text-muted">Cierra: 15/04/2023</small>
                            </div>
                            <small class="text-muted d-block mb-2">Proyectos de I+D en tecnologías emergentes</small>
                            <span class="badge bg-warning text-dark">Activa</span>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">SENA</h6>
                                <small class="text-muted">Cierra: 30/03/2023</small>
                            </div>
                            <small class="text-muted d-block mb-2">Innovación para pymes tecnológicas</small>
                            <span class="badge bg-warning text-dark">Activa</span>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">COLCIENCIAS</h6>
                                <small class="text-muted">Cierra: 20/02/2023</small>
                            </div>
                            <small class="text-muted d-block mb-2">Becas de doctorado nacionales</small>
                            <span class="badge bg-secondary">Cerrada</span>
                        </div>
                        <div class="list-group-item border-0 py-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">Ruta N</h6>
                                <small class="text-muted">Cierra: 10/05/2023</small>
                            </div>
                            <small class="text-muted d-block mb-2">Emprendimiento tecnológico Medellín</small>
                            <span class="badge bg-warning text-dark">Activa</span>
                        </div>
                    </div>
                    <div class="mt-4">
                        <button class="btn w-100" style="background-color: #EFF3FB; color: #0A2351;">
                            <i class="fas fa-calendar-alt me-2"></i>Ver calendario completo
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <% if (!user) { %>
        <div class="row mt-5">
            <div class="col-md-6 mx-auto">
                <div class="card border-0 shadow" style="background-color: #FFFFFF;">
                    <div class="card-body text-center p-5">
                        <h3 class="mb-4" style="color: #0A2351;">
                            <i class="fas fa-user-shield fa-2x mb-3" style="color: #0D5EC1;"></i><br>
                            Acceso a la Plataforma
                        </h3>
                        <p class="mb-4" style="color: #0D5EC1;">
                            Regístrate para guardar tus recursos favoritos, recibir alertas de convocatorias y personalizar tu experiencia.
                        </p>
                        <div class="d-grid gap-3">
                            <a href="/users/register" class="btn btn-lg text-white" style="background-color: #0D5EC1;">
                                <i class="fas fa-user-plus me-2"></i>Crear Cuenta
                            </a>
                            <a href="/users/login" class="btn btn-lg" style="background-color: #EFF3FB; color: #0A2351;">
                                <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>
</div>
<style>
    .hover-shadow {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(13, 94, 193, 0.15) !important;
    }
    .list-group-item:hover {
        background-color: #EFF3FB;
        border-radius: 8px;
    }
    .btn {
        transition: all 0.3s ease;
    }
    .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
</style>
