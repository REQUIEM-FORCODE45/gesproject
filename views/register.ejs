<div class="row mt-5">
    <div class="col-md-6 m-auto">
      <div class="card card-body">
        <h1 class="text-center mb-3">
          <i class="fas fa-user-plus"></i> Registro
        </h1>
        <%- include ("./partials/messages.ejs") %>
        <form action="/users/register" method="POST">

          <div class="row g-2 mb-3">
            <div class="col-md form-floating">
              <input
                type="text"
                id="name"
                name="name"
                class="form-control"
                placeholder="Digite su nombre"
                value="<%= typeof name != 'undefined' ? name : '' %>"
              />
              <label for="name"> Nombre</label>
            </div>
            <div class="col-md form-floating">
              <input
                type="text"
                id="last_name"
                name="last_name"
                class="form-control"
                placeholder="Digite su apellido"
                value="<%= typeof last_name != 'undefined' ? last_name : '' %>"
              />
              <label for="last_name"> Apellido</label>
            </div>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md form-floating">
              <select class="form-select" id="identification_type" name="identification_type">
                <option selected>Cédula de ciudadanía</option>
                <option>Documento extranjero</option>
                <option>Registro civil</option>
                <option>Pasaporte</option>
              </select>
              <label for="identification_type">Tipo de ID</label>
            </div>
            <div class="col-md form-floating">
              <input
                type="text"
                id="identification_document"
                name="identification_document"
                class="form-control"
                placeholder="Numero de identificación"
                value="<%= typeof identification_document != 'undefined' ? identification_document : '' %>"
              />
              <label for="identification_document">Numero de identificación</label>
            </div>
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md">
              <div class="form-floating">
                <input type="text" class="form-control" id="phone" name="phone" placeholder="phone"
                value="<%= typeof phone != 'undefined' ? phone : '' %>">
                <label for="phone">Teléfono</label>
              </div>
            </div>
            <div class="col-md">
              <div class="form-floating">
                <input type="text" class="form-control" id="address" name="address" placeholder="address"
                value="<%= typeof address != 'undefined' ? address : '' %>">
                <label for="address">Dirección</label>
              </div>
            </div>
          </div>
          
          <hr>

          <div class="form-floating mb-3">
            <input
              type="name"
              id="username"
              name="username"
              class="form-control"
              placeholder="Nombre de usuario"
              value="<%= typeof username != 'undefined' ? username : '' %>"
            />
            <label for="name">Nombre de usuario</label>
          </div>
          <div class="form-floating mb-3">
            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              placeholder="Digite su Email"
              value="<%= typeof email != 'undefined' ? email : '' %>"
            />
            <label for="email">Email</label>
          </div>
          <div class="form-floating mb-3">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              placeholder="Crear Contraseña"
              value="<%= typeof password != 'undefined' ? password : '' %>"
            />
            <label for="password">Contraseña</label>
          </div>
          <div class="form-floating mb-3">
            <input
              type="password"
              id="password2"
              name="password2"
              class="form-control"
              placeholder="Confirmar Contraseña"
              value="<%= typeof password2 != 'undefined' ? password2 : '' %>"
            />
            <label for="password2">Confirmar Contraseña</label>
          </div>
          <div class="text-center mt-2">
            <button type="submit" class="btn btn-primary btn-block">Registrarse </button>
          </div>
        </form>
        <p class="lead mt-4 text-center">Ya tienes una cuenta? <a href="/users/login">Iniciar sesión</a></p>
      </div>
    </div>
  </div>