<div class="row mt-5">
    <div class="col-md-6 m-auto">
      <div class="card card-body">
        <h1 class="text-center mb-3"><i class="fas fa-sign-in-alt"></i>  Iniciar sesión</h1>
        <%- include ("./partials/messages.ejs") %>
        <form action="/users/login" method="POST">
          <div class="form-floating mb-3">
            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              placeholder="Enter Email"
            />
            <label for="email">Email</label>
          </div>
          <div class="form-floating mb-3">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              placeholder="Enter Password"
            />
            <label for="password">Contraseña</label>
          </div>
          <div class="text-center">
            <button type="submit" class="btn btn-primary btn-block mt-2">Iniciar sesión</button>
          </div>
        </form>
        <p class="lead mt-4 text-center">
          Aun no tienes una cuenta? <a href="/users/register">Registrarse</a>
        </p>
      </div>
    </div>
  </div>